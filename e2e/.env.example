# AWS credentials (same as used for the Pigeons server)
PIGEONS_AWS_ACCESS_KEY_ID=
PIGEONS_AWS_SECRET_ACCESS_KEY=
PIGEONS_AWS_REGION=us-east-1
PIGEONS_FROM_EMAIL=test@fibre.dev

# ngrok (required for SNS webhook delivery to local server)
NGROK_AUTHTOKEN=

# SNS topic ARNs (created during AWS setup)
E2E_SNS_INBOUND_TOPIC_ARN=arn:aws:sns:us-east-1:138216161466:pigeons-inbound
E2E_SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:138216161466:pigeons-ses-events

# Inbound domain (the subdomain SES routes inbound email to)
E2E_INBOUND_DOMAIN=mail.fibre.dev

# Server port (optional, defaults to 3891)
PIGEONS_PORT=3891
