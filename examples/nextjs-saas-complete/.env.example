# Your Pigeons instance URL
PIGEONS_URL=http://localhost:3891

# API key (printed to stdout on first server boot)
PIGEONS_API_KEY=pgn_...

# Public URL of this Next.js app (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook secret for verifying event payloads from Pigeons.
# Set this to the secret you used when creating your webhook endpoint
# via the Pigeons API or dashboard.
WEBHOOK_SECRET=whsec_...
