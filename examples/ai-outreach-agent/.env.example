# Pigeons instance URL — your self-hosted server
PIGEONS_URL=http://localhost:3891

# Pigeons API key — create one at /v1/api-keys
PIGEONS_API_KEY=pgn_...

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Verified "From" address on your Pigeons instance
FROM_EMAIL=outreach@yourcompany.com
